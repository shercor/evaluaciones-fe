# Variables que consume docker-compose.yml (no las de la aplicación:
# esas van en backend/.env, a partir de backend/.env.example).

# Puertos publicados en el host. Cambialos si chocan con otros proyectos.
ANGULAR_PORT=4200
API_PORT=8081
DB_PORT_HOST=13306
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# Base de datos del contenedor mysql. Deben coincidir con backend/.env.
DB_DATABASE=evaluacion_personal
DB_USERNAME=ep_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
