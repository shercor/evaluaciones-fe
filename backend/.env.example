APP_NAME="Evaluación de Personal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

# El locale rige las cadenas que trae el framework —el andamiaje de los correos
# y el de recuperación de contraseña, que los arma Laravel— y están en
# `lang/es.json`. El código de la app no usa traducciones: escribe en español
# directo. El respaldo queda en `en` para lo que no esté traducido.
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=evaluacion_personal
DB_USERNAME=ep_user
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo. En desarrollo va a Mailpit (contenedor ep_mailpit): atrapa todo lo
# que se envía, no entrega nada afuera y no tiene cuota. Es la red de
# seguridad para que un envío a padrón completo no llegue a casillas reales.
# Bandeja web: http://localhost:8025
#
# Mailtrap queda para el control final de cómo se ve el correo en Gmail y
# Outlook: su plan gratuito son 50 correos al mes, insuficiente para el día a
# día. Usar credenciales PROPIAS del proyecto: no reutilizar las de la intranet.
#
# MAIL_SCHEME=smtp significa "sin TLS": Mailpit local no lo hace.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS="no-reply@evaluacion-personal.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Frontend -------------------------------------------------------
# Origen del SPA. Sanctum necesita saberlo para la cookie de sesión.
FRONTEND_URL=http://localhost:4200
SANCTUM_STATEFUL_DOMAINS=localhost:4200
SESSION_DOMAIN=localhost

# --- API de Evaluación 360 ------------------------------------------
# Equivalencias con la intranet (ver config/e360.php):
#   CFG_E360_URL -> E360_BASE_URL, pero AQUÍ CON ESQUEMA.
# La URL se resuelve desde dentro del contenedor php, no desde tu máquina.
E360_BASE_URL=http://172.17.0.1:81
E360_TENANT_CODENAME=
E360_CENTRAL_TOKEN=
E360_TENANT_TOKEN=
